cray-shared-kafka-1             | 	delegation.token.master.key = null
cray-shared-kafka-1             | 	delegation.token.max.lifetime.ms = 604800000
cray-shared-kafka-1             | 	delete.records.purgatory.purge.interval.requests = 1
cray-shared-kafka-1             | 	delete.topic.enable = true
cray-shared-kafka-1             | 	fetch.max.bytes = 57671680
cray-shared-kafka-1             | 	fetch.purgatory.purge.interval.requests = 1000
cray-shared-kafka-1             | 	group.initial.rebalance.delay.ms = 0
cray-shared-kafka-1             | 	group.max.session.timeout.ms = 1800000
cray-shared-kafka-1             | 	group.max.size = 2147483647
cray-shared-kafka-1             | 	group.min.session.timeout.ms = 6000
cray-shared-kafka-1             | 	host.name = 
