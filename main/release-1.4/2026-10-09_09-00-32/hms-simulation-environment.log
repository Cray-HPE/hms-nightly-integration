cray-sls-init-1                | Running sls-init
cray-sls-init-1                | Migrations copied to persistent location.
cray-sls-init-1                | + echo 'Running sls-init'
cray-sls-init-1                | + '[' sls-init '=' sls-init ]
cray-sls-init-1                | + '[' '!' -d /persistent_migrations ]
cray-sls-init-1                | + cp /migrations/1_add_tables.down.sql /migrations/1_add_tables.up.sql /migrations/2_add_tables.down.sql /migrations/2_add_tables.up.sql /migrations/3_add_epoch.down.sql /migrations/3_add_epoch.up.sql /persistent_migrations/
